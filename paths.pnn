// корень тип(0-сущ,1-прил,2-глаг) род(0-м,1-ж,2-ср) [доп.поля]
// доп.поля: скл=1|2|3, одуш, мягк, шип, спр=1|2|3|4, осн=…, осн2=…, прош=…

стен 0 1 скл=1
земл 0 1 скл=1 мягк
дяд 0 0 скл=1 мягк одуш
юнош 0 0 скл=1 одуш

стол 0 0 скл=2
кот 0 0 скл=2 одуш
окн 0 2 скл=2
неб 0 2 скл=2

ноч 0 1 скл=3
мыш 0 1 скл=3 одуш
радост 0 1 скл=3

врем 0 2 скл=2

красн 1 0
син 1 0 мягк
бел 1 0
больш 1 0 шип
маленьк 1 0
нов 1 0
стар 1 0

чита 2 0 спр=1 осн=чита прош=чита
гуля 2 0 спр=1 осн=гуля прош=гуля
зна 2 0 спр=1 осн=зна прош=зна
работ 2 0 спр=1 осн=работа прош=работа

говор 2 0 спр=2 осн=говор прош=говори
смотр 2 0 спр=2 осн=смотр прош=смотре
люб 2 0 спр=2 осн=любл осн2=люб прош=люби
вид 2 0 спр=2 осн=виж осн2=вид прош=виде

дыш 2 0 спр=2 осн=дыш прош=дыша
держ 2 0 спр=2 осн=держ прош=держа
слыш 2 0 спр=2 осн=слыш прош=слыша
терп 2 0 спр=2 осн=терпл осн2=терп прош=терпе
верт 2 0 спр=2 осн=верч осн2=верт прош=верте
обид 2 0 спр=2 осн=обиж осн2=обид прош=обиде
завис 2 0 спр=2 осн=завис прош=зависе
ненавид 2 0 спр=2 осн=ненавид прош=ненавиде

хот 2 0 спр=3
беж 2 0 спр=3

ес 2 0 спр=4
дам 2 0 спр=4
