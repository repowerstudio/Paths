// корень тип(0-сущ,1-прил,2-глаг) род(0-м,1-ж,2-ср) [доп.поля]
// доп.поля: скл=1|2|3, одуш, мягк, спр=1|2|3|4, осн=<основа наст.>, прош=<основа прош.>

// --- Существительные 1-го склонения ---
стен 0 1 скл=1
земл 0 1 скл=1
дяд 0 0 скл=1 одуш
юнош 0 0 скл=1 одуш

// --- Существительные 2-го склонения ---
стол 0 0 скл=2
кот 0 0 скл=2 одуш
окн 0 2 скл=2
неб 0 2 скл=2

// --- Существительные 3-го склонения ---
ноч 0 1 скл=3
мыш 0 1 скл=3 одуш
радост 0 1 скл=3

// --- Разносклоняемые на -мя ---
врем 0 2 скл=2

// --- Прилагательные ---
красн 1 0
син 1 0 мягк
бел 1 0
больш 1 0
маленьк 1 0 мягк
нов 1 0
стар 1 0

// --- Глаголы I спряжения ---
чита 2 0 спр=1 осн=чита прош=чита
гуля 2 0 спр=1 осн=гуля прош=гуля
зна 2 0 спр=1 осн=зна прош=зна
работ 2 0 спр=1 осн=работ прош=работа

// --- Глаголы II спряжения ---
говор 2 0 спр=2 осн=говор прош=говори
смотр 2 0 спр=2 осн=смотр прош=смотри
люб 2 0 спр=2 осн=любл прош=люби
вид 2 0 спр=2 осн=вид прош=виде

// --- Исключения II спряжения ---
дыш 2 0 спр=2 осн=дыш прош=дыша
держ 2 0 спр=2 осн=держ прош=держа
слыш 2 0 спр=2 осн=слыш прош=слыша
терп 2 0 спр=2 осн=терп прош=терпе
верт 2 0 спр=2 осн=верт прош=верте
обид 2 0 спр=2 осн=обид прош=обиде
завис 2 0 спр=2 осн=завис прош=зависе
ненавид 2 0 спр=2 осн=ненавид прош=ненавиде

// --- Разноспрягаемые ---
хот 2 0 спр=3
беж 2 0 спр=3

// --- Особоспрягаемые ---
ес 2 0 спр=4
дам 2 0 спр=4
